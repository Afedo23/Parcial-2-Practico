# Copie este archivo a .env  (cp .env.example .env)  y ajuste si lo desea.
# Valores EXCLUSIVAMENTE de demostración: no son secretos reales. No use comillas ni caracteres especiales en POSTGRES_PASSWORD.
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo_demo_2026
SECRET_KEY=cambie-esta-clave-demo-0123456789abcdef
APP_PORT=8000
COOKIE_SECURE=false
SESSION_HORAS=8

# Cuentas de evaluación (se crean con: docker compose exec app python -m catalogo.cli cuentas)
DEMO_ADMIN_LOGIN=admin.demo
DEMO_ADMIN_PASSWORD=AdminDemo2026
